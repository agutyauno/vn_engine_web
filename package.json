{
  "name": "vn-engine-web",
  "private": true,
  "version": "0.1.0",
  "description": "Web-based Visual Novel Engine & Publishing Platform",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "test": "pnpm -r run test",
    "test:smoke": "vitest run packages/core-vm/tests/smoke.test.ts",
    "dev:player": "pnpm --filter @vn-engine/runtime-player dev",
    "dev:editor": "pnpm --filter @vn-engine/editor dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
