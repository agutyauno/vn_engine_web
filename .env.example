# ------------------------------------------------------------------------------
# 1. CLIENT PUBLIC VARIABLES
# Chú ý: Bắt buộc phải có tiền tố VITE_ để Vite cho phép export ra trình duyệt.
# ------------------------------------------------------------------------------
# URL project Supabase của bạn:
VITE_SUPABASE_URL=https://your-project.supabase.co

# Khóa Anon công khai (được bảo vệ bởi Row Level Security ở tầng database):
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# URL CDN Cloudflare R2 lưu trữ assets tĩnh công khai:
VITE_ASSETS_CDN_URL=https://assets.your-domain.com

# Domain chính của nền tảng:
VITE_PLATFORM_ORIGIN=http://localhost:3000

# Subdomain wildcard format cho bản phát hành Web:
VITE_USERCONTENT_HOST=usercontent-platform.com

# ------------------------------------------------------------------------------
# 2. SERVER / BACKEND ONLY SECRETS
# Các khóa này chỉ được dùng trong services/backend-api và Cloudflare Workers.
# ------------------------------------------------------------------------------
# Service Role Key của Supabase 
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cloudflare Account ID & API Token để tự động quản lý R2 Bucket và DNS:
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_R2_BUCKET_NAME=vn-assets

# GitHub Personal Access Token (PAT)
# Cần quyền: repo hoặc workflow
GITHUB_PAT_DESKTOP_BUILD=ghp_your_secret_github_token_here
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=vn_engine_web

# ------------------------------------------------------------------------------
# 3. CI / CD RUNNER CONFIGURATION (Chạy kiểm thử và build tự động)
# ------------------------------------------------------------------------------
CI=false
NODE_ENV=development
