# Chương 1 — tuyến Alice
scene chapter1_alice_route ui: "phone_message_style" {
    background bg_classroom
    show alice.happy(position: "left")
    play music "bgm_school.mp3" volume: 0.7 loop: true

    alice as "???": "Cậu... là ai vậy?"
    alice as "???": "Đừng lo, tôi không hại cậu đâu."

    ~ affection = 0

    while affection < 100 {
        call .ask_question
        if affection >= 100 {
            goto good_ending
        }
    }

    reveal alice as "Alice"
    alice: "Tôi là Alice. Xin lỗi vì đã giấu tên."

    scene .ask_question {
        alice: "Cậu có muốn đi chơi với tớ không?"
        choice {
            if has_item("flower") {
                "Tặng hoa và rủ đi chơi": goto .flower_result
            }
            "Đồng ý": goto .end
            "Từ chối": goto .end
        }
    }

    scene .flower_result {
        alice: "Ôi, cảm ơn cậu!"
        ~ affection = affection + 20
        goto .end
    }

    scene .end {
        alice: "Hẹn gặp lại nhé."
        stop music fade_out: 1.5s
        return
    }

    goto normal_ending
}

scene good_ending {
    narrator: "Và họ sống hạnh phúc mãi mãi."
}

scene normal_ending {
    narrator: "Một kết thúc bình yên."
}
